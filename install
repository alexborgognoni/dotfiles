#!/usr/bin/env bash
# One-command setup of an Ubuntu machine from this repository.
#
#   curl -fsSL https://raw.githubusercontent.com/alexborgognoni/dotfiles/main/install | bash
#   ./install [machine]                     (default: work-laptop)
#
# Needs: Ubuntu 22.04+, sudo, the sops admin age key (Bitwarden item
# "sops-age-key", the SOPS_AGE_KEY variable, or pasted when asked).
# Steps (all idempotent; safe to re-run):
#   1. git and the repository                        (~/dotfiles)
#   2. the sops admin key                            (~/.config/sops/age/keys.txt)
#   3. Nix                                           (scripts/bootstrap-nix.sh)
#   4. apt packages, groups, login shell             (ansible/ubuntu.yml)
#   5. root-level config: Nix, keyd, GPU, session    (system-manager: nix/systems/<machine>.nix)
#   6. user-level config and tools                   (Home Manager: nix/homes/<machine>.nix,
#                                                     migrating chezmoi if present)
# The previous chezmoi + Ansible installer is scripts/install-legacy.sh.
set -euo pipefail

repo="${DOTFILES_REPO:-https://github.com/alexborgognoni/dotfiles.git}"
branch="${DOTFILES_BRANCH:-main}"
dir="${DOTFILES_DIR:-$HOME/dotfiles}"
machine="${1:-${DOTFILES_MACHINE:-work-laptop}}"
home_config="$(id -un | tr '[:upper:]' '[:lower:]')@$machine"
keyfile="$HOME/.config/sops/age/keys.txt"
state="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles"

log() { printf '\n\033[1;34m==> %s\033[0m\n' "$*"; }
die() { printf '\033[1;31merror:\033[0m %s\n' "$*" >&2; exit 1; }

[ "$(id -u)" -ne 0 ] || die "run as your user, not root"
grep -q '^ID=ubuntu' /etc/os-release || die "this installer is for Ubuntu (NixOS: see nix/README.md)"

log "sudo (asked once)"
sudo -n true 2>/dev/null || sudo -v
while true; do sudo -n true; sleep 50; kill -0 "$$" 2>/dev/null || exit; done 2>/dev/null &

log "1/6 Repository"
if ! command -v git >/dev/null || ! command -v curl >/dev/null; then
  sudo apt-get update -qq && sudo apt-get install -y -qq git curl ca-certificates
fi
if [ -d "$dir/.git" ]; then
  git -C "$dir" fetch -q origin "$branch" && git -C "$dir" checkout -q "$branch" && git -C "$dir" pull -q --ff-only
else
  git clone -q --branch "$branch" "$repo" "$dir"
fi
[ -f "$dir/nix/homes/$machine.nix" ] || die "unknown machine '$machine' (see $dir/nix/homes/)"

log "2/6 sops admin key"
mkdir -p "$(dirname "$keyfile")" && chmod 700 "$(dirname "$keyfile")"
if [ ! -s "$keyfile" ]; then
  if [ -n "${SOPS_AGE_KEY:-}" ]; then
    printf '%s\n' "$SOPS_AGE_KEY" > "$keyfile"
  elif [ -n "${BW_SESSION:-}" ] && command -v bw >/dev/null; then
    bw get notes sops-age-key > "$keyfile"
  else
    echo "Paste the sops admin key (AGE-SECRET-KEY-..., from Bitwarden), then press Enter:"
    read -rs key < /dev/tty
    printf '%s\n' "$key" > "$keyfile"
  fi
  chmod 600 "$keyfile"
fi
grep -q '^AGE-SECRET-KEY-' "$keyfile" || die "$keyfile does not contain an age key"

log "3/6 Nix"
"$dir/scripts/bootstrap-nix.sh"
# shellcheck disable=SC1091
. /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh
nixcmd() { nix --extra-experimental-features "nix-command flakes" "$@"; }

log "4/6 apt packages (Ansible)"
mkdir -p "$state"
nixcmd build -o "$state/ansible" "$dir/nix#ansible"
sudo "$state/ansible/bin/ansible-playbook" "$dir/ansible/ubuntu.yml"

log "5/6 System configuration (system-manager)"
nixcmd run "$dir/nix#system-manager" -- switch --flake "$dir/nix#$machine" --sudo

log "6/6 User configuration (Home Manager)"
"$dir/scripts/migrate-to-home-manager.sh" "$home_config"

log "Done"
cat <<EOF
Log out and back in to start using it:
  - zsh is your login shell; Nix apps appear in the app grid
  - the login screen offers "Hyprland (Nix)" next to GNOME
Everyday: 'nh home switch' (user) and 'sudo system-manager switch --flake $dir/nix#$machine' (system).
EOF
