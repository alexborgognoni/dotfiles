{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "catppuccin-macchiato"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "markdown": "rendered",
    "grouping": "none",
    "tps": false,
    "new_location": "launch",
    "permissions": "autoaccept",
    "image_preview": true,
    "thinking": "hide",
    "verbosity": "high"
  },
  "tabs": {
    "mode": "on",
    "layout": "vertical",
    "scope": "cwd",
    "indicators": "status"
  },
  "diffs": {
    "view": "auto",
    "wrap": "word",
    "tree": true,
    "single": false
  },
  "prompt": {
    "editor": true,
    "paste": "full",
    "image_preview": true
  },
  "attention": {
    "notifications": true,
    "sound": false,
    "volume": 0.9999999999999999
  },
  "terminal": {
    "copy": "select"
  },
  "debug": {
    "devtools": true,
    "timing": false,
    "turn_tokens": true
  },
  "experimental": {
    "new-designs": true
  },
  "scroll": {
    "speed": 3.5
  }
}
