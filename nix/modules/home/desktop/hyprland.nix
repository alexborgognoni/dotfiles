# Hyprland (Lua config, generated by Home Manager). Look and feel come from
# the active theme; the shell (bar, launcher, notifications, ...) is Noctalia.
{
  config,
  lib,
  pkgs,
  ...
}:
let
  theme = config.my.theme;
  deco = theme.decoration;
  c = config.lib.stylix.colors;
  inline = lib.generators.mkLuaInline;

  standalone = config.my.standalone;
  # On NixOS, UWSM starts each app in its own systemd unit; standalone
  # sessions have no UWSM.
  app = cmd: if standalone then cmd else "uwsm app -- ${cmd}";
  mod = "SUPER";
  noctalia = "noctalia msg";
  plugins = config.my.desktop.noctalia.plugins;

  # bind "Close window" "SUPER + Q" "hl.dsp.window.close()" { locked = true; }
  # The description is what the Noctalia keybind cheatsheet shows.
  bind' = description: keys: dispatcher: opts: {
    _args = [
      keys
      (inline dispatcher)
      (opts // { inherit description; })
    ];
  };
  bind =
    description: keys: dispatcher:
    bind' description keys dispatcher { };
  exec =
    description: keys: cmd:
    bind description keys "hl.dsp.exec_cmd(${builtins.toJSON cmd})";
  execRepeat =
    description: keys: cmd:
    bind' description keys "hl.dsp.exec_cmd(${builtins.toJSON cmd})" {
      locked = true;
      repeating = true;
    };

  # Main display = first connected of my.desktop.mainMonitors (by description),
  # else the internal panel. Workspaces 1-10 live there (the others keep the
  # leftover ones) and Noctalia shows its full bar there and the
  # workspaces-only bar elsewhere. Idempotent: it only moves what is on the
  # wrong display.
  monitorRoles =
    (pkgs.writeShellApplication {
    name = "monitor-roles";
    runtimeInputs = [
      pkgs.jq
      pkgs.util-linux
    ];
    text = ''
      # Find the running Hyprland when started outside the session (a switch
      # from a plain shell, ssh)
      if [ -z "''${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
        # shellcheck disable=SC2012
        HYPRLAND_INSTANCE_SIGNATURE="$(ls -t "''${XDG_RUNTIME_DIR:-/run/user/$UID}/hypr" | head -1)"
        export HYPRLAND_INSTANCE_SIGNATURE
      fi

      # One run at a time: every plugged monitor and every new workspace
      # starts one
      state="''${XDG_RUNTIME_DIR:-/tmp}"
      exec 9>"$state/monitor-roles.lock"
      flock 9

      # --force: set the bars even when the layout did not change (Noctalia
      # just (re)started or reloaded its config and shows both bars again)
      force=false
      [ "''${1:-}" = "--force" ] && force=true

      prefs=(${lib.escapeShellArgs config.my.desktop.mainMonitors})
      monitors="$(hyprctl monitors -j)"

      main=""
      for pref in "''${prefs[@]}"; do
        main="$(jq -r --arg p "$pref" '[.[] | select(.description | contains($p))][0].name // empty' <<<"$monitors")"
        [ -n "$main" ] && break
      done
      if [ -z "$main" ]; then
        main="$(jq -r '([.[] | select(.name | startswith("eDP"))][0] // .[0]).name' <<<"$monitors")"
      fi

      # Workspaces 1-10 belong on the main display, also those the autostart
      # apps fill a moment after login. Only workspaces with windows move:
      # moving an empty one makes Hyprland create a replacement at once,
      # which ping-pongs endlessly.
      workspaces="$(hyprctl workspaces -j)"
      for id in $(seq 1 10); do
        current="$(jq -r --argjson id "$id" '.[] | select(.id == $id and .windows > 0) | .monitor' <<<"$workspaces")"
        if [ -n "$current" ] && [ "$current" != "$main" ]; then
          hyprctl dispatch "hl.dsp.workspace.move({ workspace = \"$id\", monitor = \"$main\" })" >/dev/null
        fi
      done

      # The other displays rest on a high-numbered empty workspace (11, 12,
      # ...), not on whichever low number Hyprland picked: otherwise Super+5
      # would jump to a side display. The empty low one then disappears.
      monitors="$(hyprctl monitors -j)"
      workspaces="$(hyprctl workspaces -j)"
      focused="$(jq -r '.[] | select(.focused) | .name' <<<"$monitors")"
      number=10
      switched=false
      for name in $(jq -r --arg main "$main" '.[] | select(.name != $main) | .name' <<<"$monitors" | sort); do
        number=$((number + 1))
        active="$(jq -r --arg m "$name" '.[] | select(.name == $m) | .activeWorkspace.id' <<<"$monitors")"
        windows="$(jq -r --argjson id "$active" '.[] | select(.id == $id) | .windows' <<<"$workspaces")"
        if [ "$active" -ge 1 ] && [ "$active" -le 10 ] && [ "''${windows:-0}" -eq 0 ]; then
          hyprctl dispatch "hl.dsp.focus({ monitor = \"$name\" })" >/dev/null
          hyprctl dispatch "hl.dsp.focus({ workspace = \"$number\" })" >/dev/null
          switched=true
        fi
      done
      if $switched; then
        hyprctl dispatch "hl.dsp.focus({ monitor = \"$focused\" })" >/dev/null
      fi

      layout="$(jq -r --arg main "$main" '.[] | "\(.name) \(if .name == $main then "main" else "basic" end)"' <<<"$monitors" | sort)"
      if ! $force && [ -r "$state/monitor-roles" ] && [ "$(cat "$state/monitor-roles")" = "$layout" ]; then
        exit 0
      fi
      printf '%s\n' "$layout" > "$state/monitor-roles"
      rm -f "$state/bars-hidden"
      while read -r name role; do
        if [ "$role" = main ]; then show=main hide=basic; else show=basic hide=main; fi
        noctalia msg bar-show "$show" "$name" >/dev/null 2>&1 || true
        noctalia msg bar-hide "$hide" "$name" >/dev/null 2>&1 || true
      done <<<"$layout"
    '';
  });

  # toggle-bar all: hide every bar, or show them again. toggle-bar focused:
  # the bar of the focused display. Role-aware (monitor-roles keeps which bar
  # each display shows): Noctalia's own toggle would also flip the bars that
  # are hidden on purpose.
  toggleBar = pkgs.writeShellApplication {
    name = "toggle-bar";
    runtimeInputs = [ pkgs.jq ];
    text = ''
      # Find the running Hyprland when started outside the session
      if [ -z "''${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
        # shellcheck disable=SC2012
        HYPRLAND_INSTANCE_SIGNATURE="$(ls -t "''${XDG_RUNTIME_DIR:-/run/user/$UID}/hypr" | head -1)"
        export HYPRLAND_INSTANCE_SIGNATURE
      fi

      state="''${XDG_RUNTIME_DIR:-/tmp}"
      roles="$state/monitor-roles"
      hidden="$state/bars-hidden"
      case "''${1:-}" in
        all)
          if [ ! -s "$roles" ]; then
            noctalia msg bar-toggle
          else
            if [ -e "$hidden" ]; then
              action="bar-show"
              rm -f "$hidden"
            else
              action="bar-hide"
              : > "$hidden"
            fi
            while read -r monitor bar; do
              noctalia msg "$action" "$bar" "$monitor"
            done < "$roles"
          fi
          ;;
        focused)
          monitor="$(hyprctl monitors -j | jq -r '.[] | select(.focused) | .name')"
          bar="$(awk -v m="$monitor" '$1 == m { print $2; exit }' "$roles" 2>/dev/null || true)"
          noctalia msg bar-toggle "''${bar:-main}" "$monitor"
          ;;
        *)
          echo "usage: toggle-bar all|focused" >&2
          exit 1
          ;;
      esac
    '';
  };

  roles = config.my.desktop.mainMonitors != [ ];

  # Super+N: focus the main display (the one monitor-roles records), then
  # workspace N, so the key works the same from a side display
  gotoWorkspace = pkgs.writeShellApplication {
    name = "goto-workspace";
    text = ''
      # Find the running Hyprland when started outside the session
      if [ -z "''${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
        # shellcheck disable=SC2012
        HYPRLAND_INSTANCE_SIGNATURE="$(ls -t "''${XDG_RUNTIME_DIR:-/run/user/$UID}/hypr" | head -1)"
        export HYPRLAND_INSTANCE_SIGNATURE
      fi

      main="$(awk '$2 == "main" { print $1; exit }' "''${XDG_RUNTIME_DIR:-/tmp}/monitor-roles" 2>/dev/null || true)"
      if [ -n "$main" ]; then
        hyprctl dispatch "hl.dsp.focus({ monitor = \"$main\" })" >/dev/null
      fi
      hyprctl dispatch "hl.dsp.focus({ workspace = \"$1\" })" >/dev/null
    '';
  };

  # The session's apps start only once the user manager knows the Wayland
  # display and the settings portal answers with a colour scheme. An app
  # started earlier (Chrome at login) never learns the scheme the portal
  # reports a moment later, and stays light. Gives up after 40 s.
  waitSession = pkgs.writeShellApplication {
    name = "wait-session";
    runtimeInputs = [ pkgs.glib ];
    text = ''
      for _ in $(seq 1 200); do
        if systemctl --user show-environment | grep -q '^WAYLAND_DISPLAY='; then
          answer="$(gdbus call --session --timeout 3 --dest org.freedesktop.portal.Desktop \
            --object-path /org/freedesktop/portal/desktop \
            --method org.freedesktop.portal.Settings.Read org.freedesktop.appearance color-scheme 2>/dev/null || true)"
          case "$answer" in
            *"uint32 1"* | *"uint32 2"*) exit 0 ;;
          esac
        fi
        sleep 0.2
      done
      exit 0
    '';
  };

  directions = {
    h = "left";
    j = "down";
    k = "up";
    l = "right";
    left = "left";
    down = "down";
    up = "up";
    right = "right";
  };

  workspaceBinds = lib.concatMap (
    i:
    let
      key = toString (lib.mod i 10);
    in
    [
      (
        if roles then
          # Workspaces 1-10 live on the main display: go there first, also from a
          # side display
          exec "Workspace ${toString i}" "${mod} + ${key}" "goto-workspace ${toString i}"
        else
          bind "Workspace ${toString i}" "${mod} + ${key}" "hl.dsp.focus({ workspace = ${toString i} })"
      )
      (bind "Move window to workspace ${toString i}" "${mod} + SHIFT + ${key}"
        "hl.dsp.window.move({ workspace = ${toString i} })"
      )
    ]
  ) (lib.range 1 10);

  directionBinds = lib.concatLists (
    lib.mapAttrsToList (key: dir: [
      (bind "Focus ${dir}" "${mod} + ${key}" "hl.dsp.focus({ direction = \"${dir}\" })")
      (bind "Move window ${dir}" "${mod} + SHIFT + ${key}"
        "hl.dsp.window.move({ direction = \"${dir}\" })"
      )
    ]) directions
  );
in
{
  config = lib.mkIf config.my.features.desktop.enable {

    stylix.targets.hyprland.enable = false;

    # A switch makes Noctalia reload its config, which brings back both bars
    home.activation.monitorRoles = lib.mkIf (config.my.desktop.mainMonitors != [ ]) (
      lib.hm.dag.entryAfter [ "linkGeneration" ] ''
        ( sleep 4; ${monitorRoles}/bin/monitor-roles --force ) >/dev/null 2>&1 &
      ''
    );

    # Standalone (Ubuntu): the session the display manager starts. The system
    # layer (ansible) installs a wayland-sessions entry pointing here.
    home.packages =
      lib.optionals standalone [
        (pkgs.writeShellScriptBin "hyprland-session" ''
          # Home Manager session variables (XDG_DATA_DIRS for Nix apps, ...)
          if [ -r "$HOME/.nix-profile/etc/profile.d/hm-session-vars.sh" ]; then
            . "$HOME/.nix-profile/etc/profile.d/hm-session-vars.sh"
          fi
          export XDG_CURRENT_DESKTOP=Hyprland XDG_SESSION_DESKTOP=Hyprland
          exec ${pkgs.unstable.hyprland}/bin/start-hyprland
        '')
      ]
      ++ [
        toggleBar
        waitSession
      ]
      ++ lib.optionals roles [
        monitorRoles
        gotoWorkspace
      ];

    wayland.windowManager.hyprland = {
      enable = true;
      # NixOS installs Hyprland and its portal system-wide (programs.hyprland)
      # and UWSM manages the session; standalone, Home Manager installs both
      # and its systemd integration starts graphical-session.target.
      # Newest release (the stable channel lags a minor version behind)
      package = if standalone then pkgs.unstable.hyprland else null;
      portalPackage = if standalone then pkgs.unstable.xdg-desktop-portal-hyprland else null;
      systemd.enable = standalone;
      # The session's whole environment (cursor, Qt/GTK theming, PATH, ...) for
      # apps systemd starts, e.g. files opened from Nautilus; without it
      # XWayland apps guess their own cursor size.
      systemd.variables = [ "--all" ];
      configType = "lua";

      # hl.curve() must run before hl.animation() references the curves.
      importantPrefixes = [ "curve" ];

      settings = {
        monitor = config.my.desktop.monitors;

        env = [
          {
            _args = [
              "XCURSOR_SIZE"
              (toString theme.cursor.size)
            ];
          }
          {
            _args = [
              "HYPRCURSOR_SIZE"
              (toString theme.cursor.size)
            ];
          }
        ];

        config = {
          general = {
            gaps_in = deco.gapsIn;
            gaps_out = deco.gapsOut;
            border_size = deco.borderSize;
            col = {
              active_border = {
                colors = [
                  "rgb(${c.base0D})"
                  "rgb(${c.base0E})"
                ];
                angle = 45;
              };
              inactive_border = "rgb(${c.base03})";
            };
            resize_on_border = true;
            layout = "dwindle";
          };

          decoration = {
            rounding = deco.rounding;
            rounding_power = 2;
            shadow = {
              enabled = deco.shadow;
              range = 4;
              render_power = 3;
              color = "rgba(${c.base00}99)";
            };
            blur = {
              enabled = deco.blur;
              xray = true;
              size = 3;
              passes = 2;
              vibrancy = 0.1696;
            };
          };

          animations.enabled = true;

          dwindle.preserve_split = true;

          misc = {
            force_default_wallpaper = 0;
            disable_hyprland_logo = true;
            background_color = "rgb(${c.base00})";
          };

          input = {
            kb_layout = config.my.keyboard.layout;
            kb_options = config.my.keyboard.options;
            follow_mouse = 1;
            sensitivity = 0;
            touchpad.natural_scroll = true;
          };

          ecosystem.no_update_news = true;
        };

        curve = [
          {
            _args = [
              "easeOutQuint"
              {
                type = "bezier";
                points = [
                  [
                    0.23
                    1
                  ]
                  [
                    0.32
                    1
                  ]
                ];
              }
            ];
          }
          {
            _args = [
              "linear"
              {
                type = "bezier";
                points = [
                  [
                    0
                    0
                  ]
                  [
                    1
                    1
                  ]
                ];
              }
            ];
          }
          {
            _args = [
              "almostLinear"
              {
                type = "bezier";
                points = [
                  [
                    0.5
                    0.5
                  ]
                  [
                    0.75
                    1
                  ]
                ];
              }
            ];
          }
          {
            _args = [
              "quick"
              {
                type = "bezier";
                points = [
                  [
                    0.15
                    0
                  ]
                  [
                    0.1
                    1
                  ]
                ];
              }
            ];
          }
        ];

        animation = map (a: { leaf = builtins.head a; } // builtins.elemAt a 1) [
          [
            "global"
            {
              enabled = true;
              speed = 10;
              bezier = "default";
            }
          ]
          [
            "border"
            {
              enabled = true;
              speed = 5.39;
              bezier = "easeOutQuint";
            }
          ]
          [
            "windows"
            {
              enabled = true;
              speed = 4.79;
              bezier = "easeOutQuint";
            }
          ]
          [
            "windowsIn"
            {
              enabled = true;
              speed = 4.1;
              bezier = "easeOutQuint";
              style = "popin 87%";
            }
          ]
          [
            "windowsOut"
            {
              enabled = true;
              speed = 1.49;
              bezier = "linear";
              style = "popin 87%";
            }
          ]
          [
            "fade"
            {
              enabled = true;
              speed = 3.03;
              bezier = "quick";
            }
          ]
          [
            "layers"
            {
              enabled = true;
              speed = 3.81;
              bezier = "easeOutQuint";
            }
          ]
          [
            "workspaces"
            {
              enabled = true;
              speed = 1.94;
              bezier = "almostLinear";
              style = "fade";
            }
          ]
        ];

        gesture = {
          fingers = 3;
          direction = "horizontal";
          action = "workspace";
        };

        window_rule =
          lib.imap1 (i: a: {
            name = "autostart-${toString i}";
            match.initial_class = a.class;
            workspace = "${toString a.workspace} silent";
          }) (lib.filter (a: a.class != null && a.workspace != null) config.my.desktop.autostart)
          ++ [
            {
              name = "suppress-maximize-events";
              match.class = ".*";
              suppress_event = "maximize";
            }
            {
              name = "fix-xwayland-drags";
              match = {
                class = "^$";
                title = "^$";
                xwayland = true;
                float = true;
                fullscreen = false;
                pin = false;
              };
              no_focus = true;
            }
            {
              name = "noctalia-settings";
              match.class = "dev.noctalia.Noctalia";
              float = true;
              size = [
                1080
                920
              ];
            }
            {
              name = "theme-picker";
              match.class = "theme-picker";
              float = true;
              center = true;
              size = [
                1100
                560
              ];
            }
            {
              name = "floating-dialogs";
              match.class = "^(org.pulseaudio.pavucontrol|nm-connection-editor|blueman-manager|xdg-desktop-portal-gtk)$";
              float = true;
            }
          ];

        layer_rule = {
          name = "noctalia";
          match.namespace = "^noctalia-(bar-.+|notification|dock|panel|attached-panel|osd|window-switcher)$";
          no_anim = true;
          ignore_alpha = 0.5;
          blur = deco.blur;
          blur_popups = deco.blur;
        };

        # Hyprland's default bindings (share/hypr/hyprland.lua) with Noctalia
        # in place of hyprlauncher and the plain volume commands, plus the
        # i3-style keys: Super+Return terminal, Super+Shift+Return browser,
        # Super+Shift+Q close, Super+D launcher, vim keys (Super+O toggle split).
        bind = [
          # Hyprland defaults
          (bind "Exit Hyprland" "${mod} + M" "hl.dsp.exit()")
          (exec "File manager" "${mod} + E" (app "nautilus --new-window"))
          (bind "Toggle floating" "${mod} + V" "hl.dsp.window.float({ action = \"toggle\" })")
          (bind "Pseudo-tile window" "${mod} + P" "hl.dsp.window.pseudo()")
          (bind "Scratchpad" "${mod} + S" "hl.dsp.workspace.toggle_special(\"magic\")")
          (bind "Move window to scratchpad" "${mod} + SHIFT + S"
            "hl.dsp.window.move({ workspace = \"special:magic\" })"
          )
          (bind "Next workspace" "${mod} + mouse_down" "hl.dsp.focus({ workspace = \"e+1\" })")
          (bind "Previous workspace" "${mod} + mouse_up" "hl.dsp.focus({ workspace = \"e-1\" })")
          (bind' "Move window" "${mod} + mouse:272" "hl.dsp.window.drag()" { mouse = true; })
          (bind' "Resize window" "${mod} + mouse:273" "hl.dsp.window.resize()" { mouse = true; })

          # i3 style (defaults: Super+Q terminal, Super+C close)
          (exec "Terminal" "${mod} + RETURN" (app "kitty"))
          (exec "Browser" "${mod} + SHIFT + RETURN" (
            app "${pkgs.gtk3}/bin/gtk-launch ${config.my.desktop.browser}"
          ))
          (bind "Close window" "${mod} + SHIFT + Q" "hl.dsp.window.close()")

          # Launcher (default: Super+R with hyprlauncher) and toggle split
          # (default: Super+J, which focuses down here)
          (exec "Launcher" "${mod} + D" "${noctalia} panel-toggle launcher")
          (bind "Toggle split direction" "${mod} + O" "hl.dsp.layout(\"togglesplit\")")

          # Additions
          (exec "Hide/show all bars" "${mod} + B" "toggle-bar all")
          (exec "Hide/show the bar on this monitor" "${mod} + SHIFT + B" "toggle-bar focused")
          (bind "Fullscreen" "${mod} + F" "hl.dsp.window.fullscreen({ action = \"toggle\" })")
          (exec "Clipboard history" "${mod} + SHIFT + V" "${noctalia} panel-toggle clipboard")
          (exec "Emoji picker" "${mod} + period" "${noctalia} panel-toggle launcher /emo")
          (exec "Lock screen" "${mod} + ESCAPE" "${noctalia} session lock")
          (exec "Session menu" "${mod} + SHIFT + ESCAPE" "${noctalia} panel-toggle session")
          (exec "Theme picker" "${mod} + T" "kitty --class theme-picker --title Themes -e theme pick")
          (exec "Accent picker" "${mod} + SHIFT + T"
            "kitty --class theme-picker --title Accent -e theme accent"
          )
          (exec "Screenshot region" "PRINT" "${noctalia} screenshot-region")
          (exec "Screenshot screen" "SHIFT + PRINT" "${noctalia} screenshot-fullscreen")
          (exec "Screenshot window" "${mod} + PRINT" "${noctalia} screenshot-window")
        ]
        ++ lib.optionals (lib.elem "keybind-cheatsheet" plugins) [
          (exec "Keybind cheatsheet" "${mod} + F1"
            "${noctalia} panel-toggle kenn/keybind-cheatsheet:cheatsheet"
          )
        ]
        ++ lib.optionals (lib.elem "pomodoro" plugins) [
          (exec "Pomodoro start/pause" "${mod} + CTRL + P"
            "${noctalia} plugin thepunkoff/pomodoro:pomodoro all toggle"
          )
        ]
        ++ [

          # Hyprland keeps the layout per keyboard device, so a layout switch of
          # the xkb kind (grp:... options) only reaches the keyboard it was
          # pressed on. One command for all devices, usable on the lock screen.
          (bind' "Next keyboard layout" "${mod} + SPACE"
            "hl.dsp.exec_cmd(\"hyprctl switchxkblayout all next\")"
            { locked = true; }
          )

          # Media keys (as the defaults; Noctalia shows the OSD)
          (execRepeat "Volume up" "XF86AudioRaiseVolume" "${noctalia} volume-up")
          (execRepeat "Volume down" "XF86AudioLowerVolume" "${noctalia} volume-down")
          (execRepeat "Mute" "XF86AudioMute" "${noctalia} volume-mute")
          (execRepeat "Mute microphone" "XF86AudioMicMute" "${noctalia} mic-mute")
          (execRepeat "Brightness up" "XF86MonBrightnessUp" "${noctalia} brightness-up")
          (execRepeat "Brightness down" "XF86MonBrightnessDown" "${noctalia} brightness-down")
          (bind' "Next track" "XF86AudioNext" "hl.dsp.exec_cmd(\"playerctl next\")" { locked = true; })
          (bind' "Previous track" "XF86AudioPrev" "hl.dsp.exec_cmd(\"playerctl previous\")" {
            locked = true;
          })
          (bind' "Play/pause" "XF86AudioPlay" "hl.dsp.exec_cmd(\"playerctl play-pause\")" { locked = true; })
          (bind' "Play/pause" "XF86AudioPause" "hl.dsp.exec_cmd(\"playerctl play-pause\")" { locked = true; })
        ]
        ++ directionBinds
        ++ workspaceBinds;
      };

      # Colors and decoration of the live theme pack; `hyprctl reload` re-reads it.
      extraConfig =
        # Session apps (my.desktop.autostart): started once per session, the
        # windows of each launch placed on their workspace.
        lib.optionalString (config.my.desktop.autostart != [ ]) ''
          hl.on("hyprland.start", function()
          ${
            lib.concatMapStrings (
              a:
              let
                rules = lib.optionalString (
                  a.workspace != null && a.class == null
                ) ", { workspace = \"${toString a.workspace} silent\" }";
              in
              "  hl.exec_cmd(${builtins.toJSON "wait-session; exec ${app a.command}"}${rules})\n"
            ) config.my.desktop.autostart
          }end)
        ''
        + lib.optionalString (config.my.desktop.mainMonitors != [ ]) ''
          -- Main display and workspaces: monitor-roles (below) does the work. Only
          -- start, plug and unplug trigger it: its own effects (workspace moves,
          -- bar changes) raise layout events, and workspace_rule at runtime
          -- re-applies the monitor setup (a modeset loop that flashes the
          -- screens), so neither is listened to.
          hl.on("hyprland.start", function() hl.exec_cmd("monitor-roles") end)
          hl.on("monitor.added", function() hl.exec_cmd("monitor-roles") end)
          hl.on("monitor.removed", function() hl.exec_cmd("monitor-roles") end)
          -- the autostart apps open their windows after login; the script moves
          -- their workspaces to the main display and does nothing when all is in
          -- place (it never moves empty workspaces: that would loop)
          hl.on("workspace.created", function() hl.exec_cmd("monitor-roles") end)
          hl.on("window.open", function() hl.exec_cmd("monitor-roles") end)
        ''
        + ''
          local theme_pack = "${config.my.themeState}/current/hyprland.lua"
          local ok, err = pcall(dofile, theme_pack)
          if not ok then
            hl.exec_cmd("notify-send -a Hyprland 'Theme pack failed to load' " .. string.format("%q", tostring(err)))
          end
        '';
    };
  };
}
