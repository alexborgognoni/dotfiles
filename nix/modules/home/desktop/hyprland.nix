# Hyprland (Lua config, generated by Home Manager). Look and feel come from
# the active theme; the shell (bar, launcher, notifications, ...) is Noctalia.
{
  config,
  lib,
  pkgs,
  ...
}:
let
  theme = config.my.theme;
  deco = theme.decoration;
  c = config.lib.stylix.colors;
  inline = lib.generators.mkLuaInline;

  standalone = config.my.standalone;
  # On NixOS, UWSM starts each app in its own systemd unit; standalone
  # sessions have no UWSM.
  app = cmd: if standalone then cmd else "uwsm app -- ${cmd}";
  mod = "SUPER";
  noctalia = "noctalia msg";

  # bind "SUPER + Q" "hl.dsp.window.close()" { locked = true; }
  bind' = keys: dispatcher: opts: {
    _args = [
      keys
      (inline dispatcher)
    ]
    ++ lib.optional (opts != { }) opts;
  };
  bind = keys: dispatcher: bind' keys dispatcher { };
  exec = keys: cmd: bind keys "hl.dsp.exec_cmd(${builtins.toJSON cmd})";
  execRepeat =
    keys: cmd:
    bind' keys "hl.dsp.exec_cmd(${builtins.toJSON cmd})" {
      locked = true;
      repeating = true;
    };

  directions = {
    h = "left";
    j = "down";
    k = "up";
    l = "right";
    left = "left";
    down = "down";
    up = "up";
    right = "right";
  };

  workspaceBinds = lib.concatMap (
    i:
    let
      key = toString (lib.mod i 10);
    in
    [
      (bind "${mod} + ${key}" "hl.dsp.focus({ workspace = ${toString i} })")
      (bind "${mod} + SHIFT + ${key}" "hl.dsp.window.move({ workspace = ${toString i} })")
    ]
  ) (lib.range 1 10);

  directionBinds = lib.concatLists (
    lib.mapAttrsToList (key: dir: [
      (bind "${mod} + ${key}" "hl.dsp.focus({ direction = \"${dir}\" })")
      (bind "${mod} + SHIFT + ${key}" "hl.dsp.window.move({ direction = \"${dir}\" })")
    ]) directions
  );
in
{
  config = lib.mkIf config.my.features.desktop.enable {
    stylix.targets.hyprland.enable = false;

    # Standalone (Ubuntu): the session the display manager starts. The system
    # layer (ansible) installs a wayland-sessions entry pointing here.
    home.packages = lib.mkIf standalone [
      (pkgs.writeShellScriptBin "hyprland-session" ''
        # Home Manager session variables (XDG_DATA_DIRS for Nix apps, ...)
        if [ -r "$HOME/.nix-profile/etc/profile.d/hm-session-vars.sh" ]; then
          . "$HOME/.nix-profile/etc/profile.d/hm-session-vars.sh"
        fi
        export XDG_CURRENT_DESKTOP=Hyprland XDG_SESSION_DESKTOP=Hyprland
        exec ${pkgs.hyprland}/bin/start-hyprland
      '')
    ];

    wayland.windowManager.hyprland = {
      enable = true;
      # NixOS installs Hyprland and its portal system-wide (programs.hyprland)
      # and UWSM manages the session; standalone, Home Manager installs both
      # and its systemd integration starts graphical-session.target.
      package = if standalone then pkgs.hyprland else null;
      portalPackage = if standalone then pkgs.xdg-desktop-portal-hyprland else null;
      systemd.enable = standalone;
      configType = "lua";

      # hl.curve() must run before hl.animation() references the curves.
      importantPrefixes = [ "curve" ];

      settings = {
        monitor = config.my.desktop.monitors;

        env = [
          {
            _args = [
              "XCURSOR_SIZE"
              (toString theme.cursor.size)
            ];
          }
          {
            _args = [
              "HYPRCURSOR_SIZE"
              (toString theme.cursor.size)
            ];
          }
        ];

        config = {
          general = {
            gaps_in = deco.gapsIn;
            gaps_out = deco.gapsOut;
            border_size = deco.borderSize;
            col = {
              active_border = {
                colors = [
                  "rgb(${c.base0D})"
                  "rgb(${c.base0E})"
                ];
                angle = 45;
              };
              inactive_border = "rgb(${c.base03})";
            };
            resize_on_border = true;
            layout = "dwindle";
          };

          decoration = {
            rounding = deco.rounding;
            rounding_power = 2;
            shadow = {
              enabled = deco.shadow;
              range = 4;
              render_power = 3;
              color = "rgba(${c.base00}99)";
            };
            blur = {
              enabled = deco.blur;
              xray = true;
              size = 3;
              passes = 2;
              vibrancy = 0.1696;
            };
          };

          animations.enabled = true;

          dwindle.preserve_split = true;

          misc = {
            force_default_wallpaper = 0;
            disable_hyprland_logo = true;
            background_color = "rgb(${c.base00})";
          };

          input = {
            kb_layout = config.my.keyboard.layout;
            kb_options = config.my.keyboard.options;
            follow_mouse = 1;
            sensitivity = 0;
            touchpad.natural_scroll = true;
          };

          ecosystem.no_update_news = true;
        };

        curve = [
          {
            _args = [
              "easeOutQuint"
              {
                type = "bezier";
                points = [
                  [
                    0.23
                    1
                  ]
                  [
                    0.32
                    1
                  ]
                ];
              }
            ];
          }
          {
            _args = [
              "linear"
              {
                type = "bezier";
                points = [
                  [
                    0
                    0
                  ]
                  [
                    1
                    1
                  ]
                ];
              }
            ];
          }
          {
            _args = [
              "almostLinear"
              {
                type = "bezier";
                points = [
                  [
                    0.5
                    0.5
                  ]
                  [
                    0.75
                    1
                  ]
                ];
              }
            ];
          }
          {
            _args = [
              "quick"
              {
                type = "bezier";
                points = [
                  [
                    0.15
                    0
                  ]
                  [
                    0.1
                    1
                  ]
                ];
              }
            ];
          }
        ];

        animation = map (a: { leaf = builtins.head a; } // builtins.elemAt a 1) [
          [
            "global"
            {
              enabled = true;
              speed = 10;
              bezier = "default";
            }
          ]
          [
            "border"
            {
              enabled = true;
              speed = 5.39;
              bezier = "easeOutQuint";
            }
          ]
          [
            "windows"
            {
              enabled = true;
              speed = 4.79;
              bezier = "easeOutQuint";
            }
          ]
          [
            "windowsIn"
            {
              enabled = true;
              speed = 4.1;
              bezier = "easeOutQuint";
              style = "popin 87%";
            }
          ]
          [
            "windowsOut"
            {
              enabled = true;
              speed = 1.49;
              bezier = "linear";
              style = "popin 87%";
            }
          ]
          [
            "fade"
            {
              enabled = true;
              speed = 3.03;
              bezier = "quick";
            }
          ]
          [
            "layers"
            {
              enabled = true;
              speed = 3.81;
              bezier = "easeOutQuint";
            }
          ]
          [
            "workspaces"
            {
              enabled = true;
              speed = 1.94;
              bezier = "almostLinear";
              style = "fade";
            }
          ]
        ];

        gesture = {
          fingers = 3;
          direction = "horizontal";
          action = "workspace";
        };

        window_rule =
          lib.imap1 (i: a: {
            name = "autostart-${toString i}";
            match.initial_class = a.class;
            workspace = "${toString a.workspace} silent";
          }) (lib.filter (a: a.class != null && a.workspace != null) config.my.desktop.autostart)
          ++ [
          {
            name = "suppress-maximize-events";
            match.class = ".*";
            suppress_event = "maximize";
          }
          {
            name = "fix-xwayland-drags";
            match = {
              class = "^$";
              title = "^$";
              xwayland = true;
              float = true;
              fullscreen = false;
              pin = false;
            };
            no_focus = true;
          }
          {
            name = "noctalia-settings";
            match.class = "dev.noctalia.Noctalia";
            float = true;
            size = [
              1080
              920
            ];
          }
          {
            name = "theme-picker";
            match.class = "theme-picker";
            float = true;
            center = true;
            size = [
              1100
              560
            ];
          }
          {
            name = "floating-dialogs";
            match.class = "^(org.pulseaudio.pavucontrol|nm-connection-editor|blueman-manager|xdg-desktop-portal-gtk)$";
            float = true;
          }
          ];

        layer_rule = {
          name = "noctalia";
          match.namespace = "^noctalia-(bar-.+|notification|dock|panel|attached-panel|osd|window-switcher)$";
          no_anim = true;
          ignore_alpha = 0.5;
          blur = deco.blur;
          blur_popups = deco.blur;
        };

        # Hyprland's default bindings (share/hypr/hyprland.lua) with Noctalia
        # in place of hyprlauncher and the plain volume commands, plus the
        # i3-style keys: Super+Return terminal, Super+Shift+Return browser,
        # Super+Shift+Q close, Super+D launcher, vim keys (Super+O toggle split).
        bind = [
          # Hyprland defaults
          (bind "${mod} + M" "hl.dsp.exit()")
          (exec "${mod} + E" (app "nautilus --new-window"))
          (bind "${mod} + V" "hl.dsp.window.float({ action = \"toggle\" })")
          (bind "${mod} + P" "hl.dsp.window.pseudo()")
          (bind "${mod} + S" "hl.dsp.workspace.toggle_special(\"magic\")")
          (bind "${mod} + SHIFT + S" "hl.dsp.window.move({ workspace = \"special:magic\" })")
          (bind "${mod} + mouse_down" "hl.dsp.focus({ workspace = \"e+1\" })")
          (bind "${mod} + mouse_up" "hl.dsp.focus({ workspace = \"e-1\" })")
          (bind' "${mod} + mouse:272" "hl.dsp.window.drag()" { mouse = true; })
          (bind' "${mod} + mouse:273" "hl.dsp.window.resize()" { mouse = true; })

          # i3 style (defaults: Super+Q terminal, Super+C close)
          (exec "${mod} + RETURN" (app "kitty"))
          (exec "${mod} + SHIFT + RETURN" (app "${pkgs.gtk3}/bin/gtk-launch ${config.my.desktop.browser}"))
          (bind "${mod} + SHIFT + Q" "hl.dsp.window.close()")

          # Launcher (default: Super+R with hyprlauncher) and toggle split
          # (default: Super+J, which focuses down here)
          (exec "${mod} + D" "${noctalia} panel-toggle launcher")
          (bind "${mod} + O" "hl.dsp.layout(\"togglesplit\")")

          # Additions
          (bind "${mod} + F" "hl.dsp.window.fullscreen({ action = \"toggle\" })")
          (exec "${mod} + SHIFT + V" "${noctalia} panel-toggle clipboard")
          (exec "${mod} + ESCAPE" "${noctalia} session lock")
          (exec "${mod} + SHIFT + ESCAPE" "${noctalia} panel-toggle session")
          (exec "${mod} + T" "kitty --class theme-picker --title Themes -e theme pick")
          (exec "${mod} + SHIFT + T" "kitty --class theme-picker --title Accent -e theme accent")
          (exec "PRINT" "${noctalia} screenshot-region")
          (exec "SHIFT + PRINT" "${noctalia} screenshot-fullscreen")
          (exec "${mod} + PRINT" "${noctalia} screenshot-window")

          # Media keys (as the defaults; Noctalia shows the OSD)
          (execRepeat "XF86AudioRaiseVolume" "${noctalia} volume-up")
          (execRepeat "XF86AudioLowerVolume" "${noctalia} volume-down")
          (execRepeat "XF86AudioMute" "${noctalia} volume-mute")
          (execRepeat "XF86AudioMicMute" "${noctalia} mic-mute")
          (execRepeat "XF86MonBrightnessUp" "${noctalia} brightness-up")
          (execRepeat "XF86MonBrightnessDown" "${noctalia} brightness-down")
          (bind' "XF86AudioNext" "hl.dsp.exec_cmd(\"playerctl next\")" { locked = true; })
          (bind' "XF86AudioPrev" "hl.dsp.exec_cmd(\"playerctl previous\")" { locked = true; })
          (bind' "XF86AudioPlay" "hl.dsp.exec_cmd(\"playerctl play-pause\")" { locked = true; })
          (bind' "XF86AudioPause" "hl.dsp.exec_cmd(\"playerctl play-pause\")" { locked = true; })
        ]
        ++ directionBinds
        ++ workspaceBinds;
      };

      # Colors and decoration of the live theme pack; `hyprctl reload` re-reads it.
      extraConfig =
        # Session apps (my.desktop.autostart): started once per session, the
        # windows of each launch placed on their workspace.
        lib.optionalString (config.my.desktop.autostart != [ ]) ''
          hl.on("hyprland.start", function()
          ${lib.concatMapStrings (
            a:
            let
              rules = lib.optionalString (
                a.workspace != null && a.class == null
              ) ", { workspace = \"${toString a.workspace} silent\" }";
            in
            "  hl.exec_cmd(${builtins.toJSON (app a.command)}${rules})\n"
          ) config.my.desktop.autostart}end)
        ''
        + ''
        local theme_pack = "${config.my.themeState}/current/hyprland.lua"
        local ok, err = pcall(dofile, theme_pack)
        if not ok then
          hl.exec_cmd("notify-send -a Hyprland 'Theme pack failed to load' " .. string.format("%q", tostring(err)))
        end
      '';
    };
  };
}
