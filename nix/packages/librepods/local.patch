+fn activation_socket_path() -> PathBuf {
+    let dir = env::var("XDG_RUNTIME_DIR").unwrap_or_else(|_| "/tmp".to_string());
+    PathBuf::from(dir).join("librepods-activate.sock")
+}
+
+/// Listen for "open the window" requests from a second launch.
+/// The app has no single-instance/activation support of its own, so a second
+/// invocation of the binary exits immediately. The launcher wrapper connects
+/// to this socket instead, which reuses the existing process.
+fn spawn_activation_listener(ui_tx: tokio::sync::mpsc::UnboundedSender<BluetoothUIMessage>) {
+    let path = activation_socket_path();
+    let _ = std::fs::remove_file(&path);
+    match UnixListener::bind(&path) {
+        Ok(listener) => {
+            info!("Activation socket listening at {}", path.display());
+            std::thread::spawn(move || {
+                for stream in listener.incoming() {
+                    if stream.is_ok() {
+                        debug!("Activation request received, showing window");
+                        let _ = ui_tx.send(BluetoothUIMessage::OpenWindow);
+                    }
+                }
+            });
+        }
+        Err(e) => warn!(
+            "Failed to bind activation socket {}: {}",
+            path.display(),
+            e
+        ),
+    }
+}
