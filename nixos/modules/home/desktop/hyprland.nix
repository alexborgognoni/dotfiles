# Hyprland (Lua config, generated by Home Manager). Look and feel come from
# the active theme; the shell (bar, launcher, notifications, ...) is Noctalia.
{
  config,
  lib,
  osConfig,
  ...
}:
let
  theme = config.my.theme;
  deco = theme.decoration;
  c = config.lib.stylix.colors;
  inline = lib.generators.mkLuaInline;

  mod = "SUPER";
  noctalia = "noctalia msg";

  # bind "SUPER + Q" "hl.dsp.window.close()" { locked = true; }
  bind' =
    keys: dispatcher: opts:
    {
      _args = [
        keys
        (inline dispatcher)
      ]
      ++ lib.optional (opts != { }) opts;
    };
  bind = keys: dispatcher: bind' keys dispatcher { };
  exec = keys: cmd: bind keys "hl.dsp.exec_cmd(${builtins.toJSON cmd})";
  execRepeat =
    keys: cmd:
    bind' keys "hl.dsp.exec_cmd(${builtins.toJSON cmd})" {
      locked = true;
      repeating = true;
    };

  directions = {
    h = "left";
    j = "down";
    k = "up";
    l = "right";
    left = "left";
    down = "down";
    up = "up";
    right = "right";
  };

  workspaceBinds = lib.concatMap (
    i:
    let
      key = toString (lib.mod i 10);
    in
    [
      (bind "${mod} + ${key}" "hl.dsp.focus({ workspace = ${toString i} })")
      (bind "${mod} + SHIFT + ${key}" "hl.dsp.window.move({ workspace = ${toString i} })")
    ]
  ) (lib.range 1 10);

  directionBinds = lib.concatLists (
    lib.mapAttrsToList (key: dir: [
      (bind "${mod} + ${key}" "hl.dsp.focus({ direction = \"${dir}\" })")
      (bind "${mod} + SHIFT + ${key}" "hl.dsp.window.move({ direction = \"${dir}\" })")
      (bind "${mod} + CTRL + ${key}" "hl.dsp.window.swap({ direction = \"${dir}\" })")
    ]) directions
  );
in
{
  stylix.targets.hyprland.enable = false;

  wayland.windowManager.hyprland = {
    enable = true;
    # Hyprland and its portal are installed by the NixOS module.
    package = null;
    portalPackage = null;
    # UWSM manages the session and graphical-session.target.
    systemd.enable = false;
    configType = "lua";

    # hl.curve() must run before hl.animation() references the curves.
    importantPrefixes = [ "curve" ];

    settings = {
      monitor = osConfig.my.desktop.monitors;

      env = [
        {
          _args = [
            "XCURSOR_SIZE"
            (toString theme.cursor.size)
          ];
        }
        {
          _args = [
            "HYPRCURSOR_SIZE"
            (toString theme.cursor.size)
          ];
        }
      ];

      config = {
        general = {
          gaps_in = deco.gapsIn;
          gaps_out = deco.gapsOut;
          border_size = deco.borderSize;
          col = {
            active_border = {
              colors = [
                "rgb(${c.base0D})"
                "rgb(${c.base0E})"
              ];
              angle = 45;
            };
            inactive_border = "rgb(${c.base03})";
          };
          resize_on_border = true;
          layout = "dwindle";
        };

        decoration = {
          rounding = deco.rounding;
          rounding_power = 2;
          shadow = {
            enabled = deco.shadow;
            range = 4;
            render_power = 3;
            color = "rgba(${c.base00}99)";
          };
          blur = {
            enabled = deco.blur;
            xray = true;
            size = 3;
            passes = 2;
            vibrancy = 0.1696;
          };
        };

        animations.enabled = true;

        dwindle.preserve_split = true;

        misc = {
          force_default_wallpaper = 0;
          disable_hyprland_logo = true;
          background_color = "rgb(${c.base00})";
        };

        input = {
          kb_layout = osConfig.services.xserver.xkb.layout;
          follow_mouse = 1;
          sensitivity = 0;
          touchpad.natural_scroll = true;
        };

        ecosystem.no_update_news = true;
      };

      curve = [
        {
          _args = [
            "easeOutQuint"
            {
              type = "bezier";
              points = [
                [
                  0.23
                  1
                ]
                [
                  0.32
                  1
                ]
              ];
            }
          ];
        }
        {
          _args = [
            "linear"
            {
              type = "bezier";
              points = [
                [
                  0
                  0
                ]
                [
                  1
                  1
                ]
              ];
            }
          ];
        }
        {
          _args = [
            "almostLinear"
            {
              type = "bezier";
              points = [
                [
                  0.5
                  0.5
                ]
                [
                  0.75
                  1
                ]
              ];
            }
          ];
        }
        {
          _args = [
            "quick"
            {
              type = "bezier";
              points = [
                [
                  0.15
                  0
                ]
                [
                  0.1
                  1
                ]
              ];
            }
          ];
        }
      ];

      animation = map (a: { leaf = builtins.head a; } // builtins.elemAt a 1) [
        [
          "global"
          {
            enabled = true;
            speed = 10;
            bezier = "default";
          }
        ]
        [
          "border"
          {
            enabled = true;
            speed = 5.39;
            bezier = "easeOutQuint";
          }
        ]
        [
          "windows"
          {
            enabled = true;
            speed = 4.79;
            bezier = "easeOutQuint";
          }
        ]
        [
          "windowsIn"
          {
            enabled = true;
            speed = 4.1;
            bezier = "easeOutQuint";
            style = "popin 87%";
          }
        ]
        [
          "windowsOut"
          {
            enabled = true;
            speed = 1.49;
            bezier = "linear";
            style = "popin 87%";
          }
        ]
        [
          "fade"
          {
            enabled = true;
            speed = 3.03;
            bezier = "quick";
          }
        ]
        [
          "layers"
          {
            enabled = true;
            speed = 3.81;
            bezier = "easeOutQuint";
          }
        ]
        [
          "workspaces"
          {
            enabled = true;
            speed = 1.94;
            bezier = "almostLinear";
            style = "fade";
          }
        ]
      ];

      gesture = {
        fingers = 3;
        direction = "horizontal";
        action = "workspace";
      };

      window_rule = [
        {
          name = "suppress-maximize-events";
          match.class = ".*";
          suppress_event = "maximize";
        }
        {
          name = "fix-xwayland-drags";
          match = {
            class = "^$";
            title = "^$";
            xwayland = true;
            float = true;
            fullscreen = false;
            pin = false;
          };
          no_focus = true;
        }
        {
          name = "noctalia-settings";
          match.class = "dev.noctalia.Noctalia";
          float = true;
          size = [
            1080
            920
          ];
        }
        {
          name = "theme-picker";
          match.class = "theme-picker";
          float = true;
          center = true;
          size = [
            1100
            560
          ];
        }
        {
          name = "floating-dialogs";
          match.class = "^(org.pulseaudio.pavucontrol|nm-connection-editor|blueman-manager|xdg-desktop-portal-gtk)$";
          float = true;
        }
      ];

      layer_rule = {
        name = "noctalia";
        match.namespace = "^noctalia-(bar-.+|notification|dock|panel|attached-panel|osd|window-switcher)$";
        no_anim = true;
        ignore_alpha = 0.5;
        blur = deco.blur;
        blur_popups = deco.blur;
      };

      bind = [
        # Apps
        (exec "${mod} + RETURN" "uwsm app -- kitty")
        (exec "${mod} + B" "uwsm app -- firefox")
        (exec "${mod} + E" "uwsm app -- nautilus --new-window")

        # Shell (Noctalia)
        (exec "${mod} + SPACE" "${noctalia} panel-toggle launcher")
        (exec "${mod} + S" "${noctalia} panel-toggle control-center")
        (exec "${mod} + comma" "${noctalia} settings-toggle")
        (exec "${mod} + V" "${noctalia} panel-toggle clipboard")
        (exec "${mod} + W" "${noctalia} panel-toggle wallpaper")
        (exec "${mod} + SHIFT + W" "theme wallpaper next")
        (exec "${mod} + CTRL + W" "theme wallpaper rotate toggle")
        (exec "${mod} + ESCAPE" "${noctalia} panel-toggle session")
        (exec "${mod} + CTRL + L" "${noctalia} session lock")
        (exec "ALT + TAB" "${noctalia} window-switcher hold")
        (exec "${mod} + T" "kitty --class theme-picker --title Themes -e theme pick")
        (exec "${mod} + SHIFT + T" "kitty --class theme-picker --title Accent -e theme accent")

        # Screenshots
        (exec "PRINT" "${noctalia} screenshot-region")
        (exec "SHIFT + PRINT" "${noctalia} screenshot-fullscreen")
        (exec "${mod} + PRINT" "${noctalia} screenshot-window")

        # Windows
        (bind "${mod} + Q" "hl.dsp.window.close()")
        (bind "${mod} + F" "hl.dsp.window.fullscreen({ action = \"toggle\" })")
        (bind "${mod} + SHIFT + F" "hl.dsp.window.float({ action = \"toggle\" })")
        (bind "${mod} + P" "hl.dsp.window.pseudo()")
        (bind "${mod} + O" "hl.dsp.layout(\"togglesplit\")")

        # Scratchpad
        (bind "${mod} + grave" "hl.dsp.workspace.toggle_special(\"scratch\")")
        (bind "${mod} + SHIFT + grave" "hl.dsp.window.move({ workspace = \"special:scratch\" })")

        # Workspace scrolling and mouse move/resize
        (bind "${mod} + mouse_down" "hl.dsp.focus({ workspace = \"e+1\" })")
        (bind "${mod} + mouse_up" "hl.dsp.focus({ workspace = \"e-1\" })")
        (bind' "${mod} + mouse:272" "hl.dsp.window.drag()" { mouse = true; })
        (bind' "${mod} + mouse:273" "hl.dsp.window.resize()" { mouse = true; })

        # Media keys (Noctalia shows the OSD)
        (execRepeat "XF86AudioRaiseVolume" "${noctalia} volume-up")
        (execRepeat "XF86AudioLowerVolume" "${noctalia} volume-down")
        (execRepeat "XF86AudioMute" "${noctalia} volume-mute")
        (execRepeat "XF86AudioMicMute" "${noctalia} mic-mute")
        (execRepeat "XF86MonBrightnessUp" "${noctalia} brightness-up")
        (execRepeat "XF86MonBrightnessDown" "${noctalia} brightness-down")
        (bind' "XF86AudioNext" "hl.dsp.exec_cmd(\"playerctl next\")" { locked = true; })
        (bind' "XF86AudioPrev" "hl.dsp.exec_cmd(\"playerctl previous\")" { locked = true; })
        (bind' "XF86AudioPlay" "hl.dsp.exec_cmd(\"playerctl play-pause\")" { locked = true; })
        (bind' "XF86AudioPause" "hl.dsp.exec_cmd(\"playerctl play-pause\")" { locked = true; })
      ]
      ++ directionBinds
      ++ workspaceBinds;
    };

    # Colors and decoration of the live theme pack; `hyprctl reload` re-reads it.
    extraConfig = ''
      local theme_pack = "${config.my.themeState}/current/hyprland.lua"
      local ok, err = pcall(dofile, theme_pack)
      if not ok then
        hl.exec_cmd("notify-send -a Hyprland 'Theme pack failed to load' " .. string.format("%q", tostring(err)))
      end
    '';
  };
}
