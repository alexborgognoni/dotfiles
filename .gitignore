# Secrets and sensitive files
.env
.env.sh
*.key
*.pem
*.asc
*_rsa
*_rsa.pub
*.gpg
# ...except the public keys of apt repositories (apt/keys/, checked by test-apt-layer.sh)
!apt/keys/*.asc

# OS-specific
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Editor directories
.vscode/
.idea/
*.code-workspace

# Temporary files
*.log
*.tmp
.*.tmp

# Local machine-specific
.brewenv_cache
.zcompdump*
.zsh_history

# Build artifacts
result
result-*
node_modules/
*.o
*.so
*.dylib

# Python
__pycache__/
*.py[cod]
*$py.class
.Python
*.egg-info/

# These were in the old gitignore
tmux/plugins
**/lazy-lock.json

# Keep empty directories
!.gitkeep
